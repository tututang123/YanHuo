# Copy to /root/private/dnf-70/aionui.env on the server.
# Fill real values there. Do not commit the filled env file.

# DingTalk Stream robot credentials
AIONUI_DINGTALK_CLIENT_ID=
AIONUI_DINGTALK_CLIENT_SECRET=

# Model provider credentials
AIONUI_OPENROUTER_API_KEY=

# Optional OpenAI-compatible provider used by Codex or custom endpoints
OPENAI_API_KEY=
OPENAI_BASE_URL=https://modrouter.top/v1

# Optional external CLI agent homes
CODEX_HOME=/root/.codex
ANTHROPIC_API_KEY=

# Optional runtime tuning
AIONUI_DATA_DIR=/root/.config/AionUi
